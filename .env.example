# IMPORTANT: With compose.yaml DATABASE_URL composed as a string, DB and RabbitMQ
# passwords must use URL-safe characters (A-Z, a-z, 0-9, _ or -).
# For arbitrary special characters, encode URL components or use URL.create() in Python.
# Never commit the local .env file.
# LOCAL DEVELOPMENT ONLY. Copy to .env and change secrets before any public deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_change_me

AUTH_DB_PASSWORD=local_auth_change_me
ROOM_DB_PASSWORD=local_room_change_me
TENANT_DB_PASSWORD=local_tenant_change_me
METERING_DB_PASSWORD=local_metering_change_me
BILLING_DB_PASSWORD=local_billing_change_me
NOTIFICATION_DB_PASSWORD=local_notification_change_me

RABBITMQ_DEFAULT_USER=rental_dev
RABBITMQ_DEFAULT_PASS=local_rabbit_change_me
SERVICE_TOKEN=local_internal_token_change_me
JWT_SECRET=local_jwt_secret_change_me_to_random
OWNER_EMAIL=owner@example.com

# Optional sandbox credentials used by compose.p11.yaml.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_IPN_URL=
# Optional email provider credentials.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
